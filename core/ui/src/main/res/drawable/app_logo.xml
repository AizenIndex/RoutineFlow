<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Ring (Coral/Sunset) -->
    <path
        android:pathData="M54,18 A36,36 0 1,1 22,68"
        android:strokeWidth="5.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFF512F" />
                <item android:offset="1.0" android:color="#FFF09819" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Middle Ring (Indigo/Violet) -->
    <path
        android:pathData="M54,27 A27,27 0 1,1 30,66"
        android:strokeWidth="5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="27"
                android:startY="27"
                android:endX="81"
                android:endY="81"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF6366F1" />
                <item android:offset="1.0" android:color="#FFA855F7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Ring (Cyan/Emerald) -->
    <path
        android:pathData="M54,36 A18,18 0 1,1 38,62"
        android:strokeWidth="4.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="36"
                android:startY="36"
                android:endX="72"
                android:endY="72"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF06B6D4" />
                <item android:offset="1.0" android:color="#FF10B981" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Clean Checkmark -->
    <path
        android:pathData="M48,54 L52,58 L61,49"
        android:strokeWidth="4.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
